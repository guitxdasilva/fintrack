generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  image         String?
  hasCompletedTour Boolean @default(false)
  /// Balance the user had on `initialBalanceDate` (calendar date, 12:00 UTC).
  /// Transactions on or after that date move it; earlier ones are already in it.
  initialBalance     Float     @default(0)
  initialBalanceDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  transactions   Transaction[]
  categories     Category[]
  goals          Goal[]
  cards          Card[]
  passwordResets PasswordResetToken[]
  feedbacks      Feedback[]
  recurrenceDismissals RecurrenceDismissal[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Transaction {
  id          String            @id @default(cuid())
  amount      Float
  type        TransactionType
  description String
  date        DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId  String
  category    Category          @relation(fields: [categoryId], references: [id])

  paymentType String?
  cardId      String?
  card        Card?             @relation(fields: [cardId], references: [id])

  cardType           String?
  installments       Int?
  currentInstallment Int?
  installmentGroupId String?
  paid               Boolean   @default(false)
  paidAt             DateTime?
  isFixed            Boolean   @default(false)
  purchaseDate       DateTime?

  /// Refunds are INCOME rows that reduce spending (invoice, budget, category
  /// totals) instead of counting as income. A linked refund points to the
  /// purchase it refunds and sits in that purchase's invoice.
  isRefund           Boolean       @default(false)
  refundOfId         String?
  refundOf           Transaction?  @relation("Refunds", fields: [refundOfId], references: [id], onDelete: Cascade)
  refunds            Transaction[] @relation("Refunds")

  @@index([userId])
  @@index([date])
  @@index([installmentGroupId])
  @@index([refundOfId])
}

model Category {
  id          String        @id @default(cuid())
  name        String
  icon        String?
  color       String        @default("#6366f1")
  type        TransactionType
  budget      Float?
  createdAt   DateTime      @default(now())

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@unique([name, userId])
  @@index([userId])
}

model Goal {
  id          String    @id @default(cuid())
  name        String
  targetAmount Float
  currentAmount Float   @default(0)
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Card {
  id              String   @id @default(cuid())
  name            String
  icon            String?
  closingDayType  String?
  closingDayValue Int?
  createdAt       DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@unique([name, userId])
  @@index([userId])
}

enum TransactionType {
  INCOME
  EXPENSE
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email])
}

enum FeedbackType {
  BUG
  SUGGESTION
  COMPLIMENT
}

model Feedback {
  id        String       @id @default(cuid())
  type      FeedbackType
  message   String
  createdAt DateTime     @default(now())

  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A recurring-transaction suggestion the user chose to ignore.
model RecurrenceDismissal {
  id        String          @id @default(cuid())
  /// Normalized description (see lib/recurrence/detect.ts → recurrenceKey)
  key       String
  type      TransactionType
  createdAt DateTime        @default(now())

  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, key])
}
